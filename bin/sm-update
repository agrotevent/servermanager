#!/bin/bash
# =============================================================================
#  Servermanager - Selbstaktualisierung aus dem Git-Repository
#  Wird über "sm-helper self-update" per systemd-run als root gestartet.
# =============================================================================
set -uo pipefail

CONF_DIR=/etc/servermanager
CONF="$CONF_DIR/servermanager.conf"
APP_DIR=/opt/servermanager
BRANCH=main
SVC_USER=servermanager
LISTEN=127.0.0.1:8000

conf_get() {
    [ -f "$CONF" ] || return 0
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" "$CONF" | head -n 1
}
v="$(conf_get repo_dir)"; [ -n "$v" ] && APP_DIR="$v"
v="$(conf_get branch)"; [ -n "$v" ] && BRANCH="$v"
v="$(conf_get listen)"; [ -n "$v" ] && LISTEN="$v"

# root-owned log directory (never write as root into the service user's data directory)
install -d -m 755 /var/log/servermanager
LOG=/var/log/servermanager/update.log
rm -f "$LOG"
( umask 022; : > "$LOG" )
exec >>"$LOG" 2>&1

say() { echo "[$(date '+%H:%M:%S')] $*"; }

cd "$APP_DIR" || { say "FEHLER: $APP_DIR nicht gefunden"; exit 1; }
say "Servermanager-Update gestartet (Branch $BRANCH)"
OLD="$(git rev-parse HEAD)"

rollback() {
    say "FEHLER: $1 - setze auf $OLD zurück"
    git reset --hard "$OLD"
    "$APP_DIR/.venv/bin/pip" install -q -r requirements.txt || true
    systemctl restart servermanager-worker servermanager-web
    say "Rollback abgeschlossen. Hinweis: Eine bereits migrierte Datenbank kann aus der Sicherung vor dem Update wiederhergestellt werden."
    exit 1
}

git fetch --quiet origin "$BRANCH" || { say "FEHLER: git fetch fehlgeschlagen"; exit 1; }
NEW="$(git rev-parse "origin/$BRANCH")"
if [ "$OLD" = "$NEW" ]; then
    say "Bereits auf dem neuesten Stand ($OLD)."
    exit 0
fi
say "Aktualisiere ${OLD:0:12} -> ${NEW:0:12}"
git log --format='  %h %s' "$OLD..$NEW" | head -n 50
git reset --hard "$NEW" || rollback "git reset fehlgeschlagen"
chmod 755 bin/sm-helper bin/sm-update bin/servermanager-cli 2>/dev/null || true

say "Python-Abhängigkeiten aktualisieren"
"$APP_DIR/.venv/bin/pip" install -q --upgrade pip >/dev/null 2>&1 || true
"$APP_DIR/.venv/bin/pip" install -q -r requirements.txt || rollback "pip install fehlgeschlagen"
SITE="$("$APP_DIR/.venv/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
echo "$APP_DIR" > "$SITE/servermanager-app.pth"

say "systemd-Units prüfen"
changed=0
for unit in servermanager-web.service servermanager-worker.service; do
    if ! cmp -s "deploy/$unit" "/etc/systemd/system/$unit"; then
        install -m 644 "deploy/$unit" "/etc/systemd/system/$unit"
        changed=1
    fi
done
install -m 755 bin/servermanager-cli /usr/local/bin/servermanager-cli
[ "$changed" = "1" ] && systemctl daemon-reload

say "Datenbank migrieren"
runuser -u "$SVC_USER" -- env SM_CONFIG="$CONF" "$APP_DIR/.venv/bin/python" -m servermanager.cli migrate \
    || rollback "Migration fehlgeschlagen"

say "Dienste neu starten"
systemctl restart servermanager-worker servermanager-web
for _ in $(seq 1 30); do
    if curl -fsS "http://$LISTEN/healthz" >/dev/null 2>&1; then
        say "Update erfolgreich abgeschlossen: $(git log -1 --format='%h %s')"
        exit 0
    fi
    sleep 2
done
rollback "Weboberfläche startet nach dem Update nicht"
