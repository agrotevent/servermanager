#!/bin/bash
# =============================================================================
#  Servermanager - privilegierter Helfer
#  Wird vom Dienstbenutzer "servermanager" per sudo aufgerufen (siehe
#  /etc/sudoers.d/servermanager). Jede Aktion prüft ihre Parameter selbst.
# =============================================================================
set -euo pipefail
umask 022

CONF_DIR=/etc/servermanager
CONF="$CONF_DIR/servermanager.conf"
APP_DIR=/opt/servermanager
DATA_DIR=/var/lib/servermanager
BRANCH=main
SVC_USER=servermanager
LOG_DIR=/var/log/servermanager
CRED_FILE="$CONF_DIR/git-credentials"
export GIT_TERMINAL_PROMPT=0

conf_get() {
    [ -f "$CONF" ] || return 0
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"\(.*\)\"[[:space:]]*$/\1/p" "$CONF" | head -n 1
}
v="$(conf_get data_dir)"; [ -n "$v" ] && DATA_DIR="$v"
v="$(conf_get repo_dir)"; [ -n "$v" ] && APP_DIR="$v"
v="$(conf_get branch)"; [ -n "$v" ] && BRANCH="$v"

die() { echo "sm-helper: $*" >&2; exit 1; }
git_cred() {  # git with the stored repository token (if any)
    if [ -f "$CRED_FILE" ]; then
        git -c credential.helper= -c "credential.helper=store --file=$CRED_FILE" "$@"
    else
        git "$@"
    fi
}
valid_iface() { [[ "${1:-}" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || die "ungültiger Interface-Name"; }
[[ "$BRANCH" =~ ^[A-Za-z0-9._/-]+$ ]] || die "ungültiger Branch in $CONF"

# Only these WireGuard settings are accepted - in particular no PostUp/PreUp
# hooks, which would allow running commands as root.
validate_wg_conf() {
    local f="$1"
    [ -f "$f" ] && [ ! -L "$f" ] || die "Konfiguration $f fehlt"
    if grep -vE '^[[:space:]]*(#.*|\[Interface\]|\[Peer\]|(PrivateKey|Address|MTU|PublicKey|Endpoint|AllowedIPs|PersistentKeepalive)[[:space:]]*=[[:space:]]*[]A-Za-z0-9+/=.:,_ [-]+)?[[:space:]]*$' "$f" | grep -q .; then
        die "Konfiguration $f enthält unzulässige Einträge"
    fi
}

cmd="${1:-}"
shift || true

case "$cmd" in
    wg-apply)
        iface="${1:-}"; valid_iface "$iface"
        src="$DATA_DIR/wireguard/$iface.conf"
        command -v wg >/dev/null 2>&1 || die "wireguard-tools sind nicht installiert"
        # The source directory belongs to the service user: copy first (without following
        # symlinks) and validate the root-owned copy, so the file cannot be swapped afterwards.
        tmp="$(mktemp /run/sm-wg.XXXXXX)"
        trap 'rm -f "$tmp"' EXIT
        [ -f "$src" ] && [ ! -L "$src" ] || die "Konfiguration $src fehlt"
        cp -P --remove-destination "$src" "$tmp"
        validate_wg_conf "$tmp"
        install -d -m 700 /etc/wireguard
        install -m 600 -o root -g root "$tmp" "/etc/wireguard/$iface.conf"
        systemctl enable "wg-quick@$iface" >/dev/null 2>&1 || true
        if ip link show "$iface" >/dev/null 2>&1; then
            wg syncconf "$iface" <(wg-quick strip "$iface")
            wanted="$(sed -n 's/^[[:space:]]*AllowedIPs[[:space:]]*=[[:space:]]*//p' "/etc/wireguard/$iface.conf" | tr ',' ' ')"
            for net in $wanted; do
                ip route replace "$net" dev "$iface"
            done
            # remove routes that are no longer part of AllowedIPs
            ip -4 route show dev "$iface" | awk '{print $1}' | while read -r r; do
                keep=0
                for net in $wanted; do [ "$net" = "$r" ] && keep=1; done
                [ "$keep" = "1" ] || ip route del "$r" dev "$iface" 2>/dev/null || true
            done
            echo "Tunnel $iface aktualisiert."
        else
            systemctl restart "wg-quick@$iface" || die "wg-quick@$iface konnte nicht gestartet werden (journalctl -u wg-quick@$iface). In LXC: WireGuard-Modul auf dem Host laden."
            echo "Tunnel $iface gestartet."
        fi
        ;;

    wg-show)
        iface="${1:-}"; valid_iface "$iface"
        wg show "$iface" dump 2>&1 || true
        ;;

    wg-down)
        iface="${1:-}"; valid_iface "$iface"
        systemctl disable --now "wg-quick@$iface" 2>&1 || true
        ;;

    git-fetch)
        git_cred -C "$APP_DIR" fetch --quiet origin "$BRANCH" 2>&1
        ;;

    git-branches)
        # remote branches (one per line) and the default branch of the repository
        git_cred -C "$APP_DIR" ls-remote --heads origin 2>&1 | sed -n 's#^[0-9a-f]*[[:space:]]*refs/heads/#branch=#p'
        git_cred -C "$APP_DIR" ls-remote --symref origin HEAD 2>/dev/null \
            | sed -n 's#^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$#default=\1#p'
        echo "current=$BRANCH"
        ;;

    set-branch)
        new="${1:-}"
        [[ "$new" =~ ^[A-Za-z0-9._/-]{1,200}$ ]] || die "ungültiger Branch-Name"
        git_cred -C "$APP_DIR" ls-remote --exit-code --heads origin "$new" >/dev/null 2>&1 \
            || die "Branch '$new' gibt es im Repository nicht"
        [ -f "$CONF" ] && [ ! -L "$CONF" ] || die "$CONF fehlt"
        if grep -q '^branch = ' "$CONF"; then
            sed -i "s|^branch = .*|branch = \"$new\"|" "$CONF"
        else
            sed -i "s|^\[update\]|[update]\nbranch = \"$new\"|" "$CONF"
        fi
        git_cred -C "$APP_DIR" fetch --quiet origin "$new" 2>&1
        echo "Update-Branch ist jetzt '$new'."
        ;;

    git-token-status)
        # prints "none" or "set <user> <host> …<last 4 characters>" - never the token itself
        if [ -f "$CRED_FILE" ]; then
            line="$(head -n 1 "$CRED_FILE")"
            creds="${line#https://}"; host="${creds##*@}"; host="${host//%3[aA]/:}"; creds="${creds%@*}"
            tok="${creds#*:}"
            echo "set ${creds%%:*} $host …${tok: -4}"
        else
            echo "none"
        fi
        ;;

    set-git-token)
        # token is read from stdin (never as argument - it would show up in the process list)
        user="${1:-x-access-token}"
        [[ "$user" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || die "ungültiger Token-Benutzer"
        IFS= read -r token || true
        if [ -z "$token" ]; then
            rm -f "$CRED_FILE"
            git -C "$APP_DIR" config --unset-all credential.helper 2>/dev/null || true
            echo "Zugriffstoken entfernt."
            exit 0
        fi
        [[ "$token" =~ ^[A-Za-z0-9_.~-]{8,255}$ ]] || die "ungültiges Token (erlaubt: A-Z a-z 0-9 _ . ~ -)"
        url="$(git -C "$APP_DIR" config --get remote.origin.url || true)"
        host="$(sed -nE 's#^https://([^/@]*@)?([^/]+)/.*$#\2#p' <<<"$url")"
        [ -n "$host" ] || die "Ein Token wird nur für https-Repositories unterstützt"
        [[ "$url" =~ ^https://[^/@]*@ ]] && die "Die Repository-Adresse enthält bereits Zugangsdaten - bitte install.sh erneut ausführen"
        tmp="$(mktemp "$CONF_DIR/.git-credentials.XXXXXX")"
        trap 'rm -f "$tmp"' EXIT
        chmod 600 "$tmp"
        printf 'https://%s:%s@%s\n' "$user" "$token" "$host" > "$tmp"
        # check the token before replacing the stored one
        git -c credential.helper= -c "credential.helper=store --file=$tmp" -C "$APP_DIR" \
            ls-remote --exit-code origin "refs/heads/$BRANCH" >/dev/null 2>&1 \
            || die "Zugriff auf $host mit diesem Token fehlgeschlagen (Rechte, Ablaufdatum und Branch $BRANCH prüfen)"
        chown root:root "$tmp"
        mv -f "$tmp" "$CRED_FILE"
        git -C "$APP_DIR" config --replace-all credential.helper "store --file=$CRED_FILE"
        echo "Zugriffstoken gespeichert und geprüft."
        ;;

    self-update)
        [ -x "$APP_DIR/bin/sm-update" ] || die "$APP_DIR/bin/sm-update fehlt"
        # run outside of the web service cgroup - the services get restarted.
        # --no-block: do not wait for the (oneshot) update to finish - it restarts the web service,
        # which would kill this helper while it is still waiting.
        systemd-run --no-block --unit="servermanager-update-$(date +%s)" --collect --property=Type=oneshot \
            --property=TimeoutStartSec=1800 "$APP_DIR/bin/sm-update" >/dev/null 2>&1 \
            || die "Update-Dienst konnte nicht gestartet werden (systemd-run)"
        echo "Update gestartet."
        ;;

    restore)
        systemd-run --no-block --unit="servermanager-restore-$(date +%s)" --collect --property=Type=oneshot \
            "$APP_DIR/bin/sm-helper" restore-apply >/dev/null 2>&1 \
            || die "Wiederherstellung konnte nicht gestartet werden (systemd-run)"
        echo "Wiederherstellung gestartet."
        ;;

    restore-apply)
        # only started through "restore" (systemd-run), never directly through sudo
        [ -z "${SUDO_USER:-}" ] || die "restore-apply wird nur über 'restore' gestartet"
        STAGE="$DATA_DIR/restore-staging"
        install -d -m 755 "$LOG_DIR"
        LOG="$LOG_DIR/restore.log"
        # whatever happens: the services must be running again afterwards
        trap 'systemctl start servermanager-worker servermanager-web >/dev/null 2>&1 || true' EXIT
        {
            echo "== Wiederherstellung $(date)"
            # Stop everything running as the service user first: from now on nobody can
            # modify the files below $DATA_DIR while root works on them.
            systemctl stop servermanager-web servermanager-worker || true
            pkill -KILL -u "$SVC_USER" 2>/dev/null || true
            sleep 1
            restore_fail() {
                echo "FEHLER: $* - Wiederherstellung abgebrochen, bisheriger Stand bleibt aktiv."
                systemctl start servermanager-worker servermanager-web || true
                exit 1
            }
            [ -d "$STAGE" ] && [ ! -L "$STAGE" ] || restore_fail "keine vorbereitete Wiederherstellung"
            if find "$STAGE" -type l | grep -q .; then restore_fail "symbolische Links in der Sicherung sind nicht erlaubt"; fi
            [ -f "$STAGE/servermanager.db" ] && [ -f "$STAGE/secret.key" ] || restore_fail "Sicherung unvollständig"
            for f in "$DATA_DIR/servermanager.db" "$DATA_DIR/servermanager.db-wal" "$DATA_DIR/servermanager.db-shm"; do
                [ -L "$f" ] && rm -f "$f"
            done
            ts="$(date +%Y%m%d-%H%M%S)"
            keep="$(mktemp -d "/var/backups/servermanager-pre-restore-$ts.XXXXXX")"
            cp -P "$DATA_DIR"/servermanager.db* "$keep/" 2>/dev/null || true
            cp -P "$CONF_DIR/secret.key" "$keep/" 2>/dev/null || true
            echo "Bisheriger Stand gesichert in $keep"
            # Files below $DATA_DIR belong to the service user: handle them AS the service user, so a
            # symlink planted there can never make root read or write elsewhere.
            as_svc() { runuser -u "$SVC_USER" -- "$@"; }
            as_svc rm -f "$DATA_DIR/servermanager.db-wal" "$DATA_DIR/servermanager.db-shm"
            as_svc install -m 600 "$STAGE/servermanager.db" "$DATA_DIR/servermanager.db" \
                || restore_fail "Datenbank konnte nicht übernommen werden"
            # Files for root-owned places: copy them (without following links) into a private
            # root directory first and check them there.
            priv="$(mktemp -d)"
            cp -P "$STAGE/secret.key" "$priv/secret.key" 2>/dev/null || true
            [ -f "$STAGE/servermanager.conf" ] && cp -P "$STAGE/servermanager.conf" "$priv/servermanager.conf" 2>/dev/null
            [ -f "$priv/secret.key" ] && [ ! -L "$priv/secret.key" ] || { rm -rf "$priv"; restore_fail "secret.key ungültig"; }
            install -m 640 -o root -g "$SVC_USER" "$priv/secret.key" "$CONF_DIR/secret.key"
            if [ -f "$priv/servermanager.conf" ] && [ ! -L "$priv/servermanager.conf" ]; then
                install -m 640 -o root -g "$SVC_USER" "$priv/servermanager.conf" "$CONF_DIR/servermanager.conf.from-backup-$ts"
                echo "Konfiguration aus der Sicherung abgelegt: $CONF_DIR/servermanager.conf.from-backup-$ts (aktive Konfiguration unverändert)"
            fi
            rm -rf "$priv"
            for d in ssh wireguard system-backups; do
                if [ -d "$STAGE/$d" ]; then
                    as_svc rm -rf "${DATA_DIR:?}/$d"
                    as_svc cp -rP "$STAGE/$d" "$DATA_DIR/$d"
                    as_svc chmod 700 "$DATA_DIR/$d"
                fi
            done
            as_svc rm -rf "$STAGE"
            (cd "$APP_DIR" && runuser -u "$SVC_USER" -- env SM_CONFIG="$CONF" "$APP_DIR/.venv/bin/python" -m servermanager.cli migrate)
            systemctl start servermanager-worker servermanager-web
            for f in "$DATA_DIR"/wireguard/*.conf; do
                [ -f "$f" ] || continue
                # re-apply only tunnels that were already set up on this host
                if [ -f "/etc/wireguard/$(basename "$f")" ]; then
                    "$0" wg-apply "$(basename "$f" .conf)" || echo "WireGuard $(basename "$f") konnte nicht angewendet werden"
                fi
            done
            echo "== Wiederherstellung abgeschlossen"
        } > "$LOG" 2>&1
        chmod 644 "$LOG"
        ;;

    restart)
        systemctl restart servermanager-worker servermanager-web
        ;;

    *)
        echo "Verwendung: sm-helper {wg-apply|wg-show|wg-down IFACE | git-fetch | git-branches | set-branch NAME | git-token-status | set-git-token [USER] | self-update | restore | restart}" >&2
        exit 2
        ;;
esac
